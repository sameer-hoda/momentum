# Sign-in, option A — set it here (takes precedence).
# Sign-in, option B — leave these empty and create email + password
# on the sign-in page at first visit (stored hashed on the volume).
APP_PASSWORD=

# Email for the sign-in screen. Must match at login when set.
APP_EMAIL=you@example.com

# AI features (thread analysis + reply drafts). The board works without it
# (heuristic fallback), but it is much better with it.
GEMINI_API_KEY=

# Your display name in WhatsApp — powers "needs you" ranking + reply voice.
OWNER_NAME=

# 1 = try instantly with synthetic demo data (no WhatsApp pairing needed).
DEMO_MODE=0

# Set to 1 only when you want the UI to actually deliver WhatsApp messages.
MOMENTUM_LIVE=0

# Railway injects PORT automatically. STORE_DIR must be your Volume mount.
# PORT=8080
# STORE_DIR=/data/store
