# Local end-to-end run — Momentum + WhatsApp QR pairing + live nudge audit.
# Source this file, then run the three processes (each in its own terminal).
#
#   source local-run/local.env
#   ./local-run/bridge.sh      # terminal 1: pairing QR + message sync -> local-store/
#   ./local-run/provision.sh   # terminal 2: sync-stable -> analysis -> frontend_data.json
#   ./local-run/api.sh         # terminal 3: UI + API on :8099
#
# Or start everything backgrounded: ./local-run/start-all.sh
# Stop everything: ./local-run/stop-all.sh
# Watch the audit: ./local-run/audit.sh  (pipeline + nudges as they land)

# --- paths (absolute, so any cwd works) ---
export V3_DIR="/Users/sameerhoda/Projects/wa-wunderlist/v3"
export STORE_DIR="$V3_DIR/local-store"
export BRIDGE_LOG="$V3_DIR/local-run/bridge.log"

# --- network (bridge REST is hardcoded :8080 in bridge/main.go:957; UI stays clear) ---
export PORT="8099"                        # UI + API
export WA_BRIDGE_URL="http://localhost:8080"  # bridge REST (fixed)

# --- auth (first run: leave empty, create email+password in the UI) ---
export APP_PASSWORD=""
export APP_EMAIL=""

# --- AI (read from ../v2/.env at start-all time; pasted below on first run) ---
# export GEMINI_API_KEY="..."

# --- identity: pipeline self-detects from is_from_me + mentions;
# OWNER_NAME left empty so nothing is hardcoded. Set after first analysis if
# "needs you" ranking looks off (must match your WhatsApp display name).
export OWNER_NAME=""

# --- behavior ---
export DEMO_MODE="0"        # 0 = real WhatsApp via QR
export MOMENTUM_LIVE="1"    # 1 = LIVE sends deliver (your choice); 0 = dry-run logged only
# Key gate: the journey always stops here so the user pastes (or skips)
# a key that is validated live in the UI. SKIP_KEY_CHECK stays available
# as an escape hatch, but ASK_KEY_FIRST is the flow.
export SKIP_KEY_CHECK="1"
export ASK_KEY_FIRST="1"
# Local QR-first flow: the bridge opens :8080 only AFTER pairing, so the
# provisioner's TCP wait would time out. Skip it — pairing is verified via
# message count + bridge log instead.
export SKIP_BRIDGE_WAIT="1"
export BRIDGE_VERBOSE="0"   # 1 = also log message bodies (default off: bodies stay in SQLite)
